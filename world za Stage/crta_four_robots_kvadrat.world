include "include/robots.inc"

resolution 0.02

interval_sim 100  

define floorplan model
(
  color "gray30"

  boundary 0

  gui_nose 0
  gui_grid 0

  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

window
(
  size [ 901.000 666.000 ] # in pixels
  scale 20   # pixels per meter
  center [ -0.000  -0.000 ]
  rotate [ 0  0 ]

  show_data 1              # 1=on 0=off
)

floorplan
( 
  name "crta"
  size [45.05 33.300 1.000]
  pose [0 0 0 0]
  bitmap "bitmaps/crta.pgm"
  gui_move 0
)

define my_block model
(
  size [0.5 0.5 0.5]
  gui_nose 0
)

define mount model
(
  size [0.02 0.02 0.5]
  gui_nose 0
)

pioneer2dx_with_laser_and_camera 
(

  name "robot_0"
  color "green" 
  pose [ 16 7 0 180 ] 
)

pioneer2dx_with_laser_and_camera 
(
  name "robot_1"
  color "blue" 
  pose [ 16 8 0 180 ] 
)

pioneer2dx_with_laser_and_camera 
(

  name "robot_2"
  color "red" 
  pose [ 17 7 0 180 ] 
)

pioneer2dx_with_laser_and_camera 
(

  name "robot_3"
  color "yellow" 
  pose [ 17 8 0 180 ] 
)
