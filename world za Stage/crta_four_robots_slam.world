# crta_three_robots.world
# prilagođeno iz cave_three_robots.world

include "include/robots.inc"

# set the resolution of the underlying raytrace model in meters
resolution 0.02

# simulation timestep in milliseconds
interval_sim 100  

define floorplan model
(
  # sombre, sensible, artistic
  color "gray30"

  # most maps will need a bounding box
  boundary 0

  gui_nose 0
  gui_grid 0

  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

# configure the GUI window
window
(
  size [ 901.000 666.000 ] # in pixels
  scale 20   # pixels per meter
  center [ -0.000  -0.000 ]
  rotate [ 0  0 ]

  show_data 1              # 1=on 0=off
)

# load an environment bitmap
floorplan
( 
  name "crta"
  size [45.05 33.300 1.000]
  pose [0 0 0 0]
  bitmap "bitmaps/crta.pgm"
  gui_move 0
)

# define a block
define my_block model
(
  size [0.5 0.5 0.5]
  gui_nose 0
)

# define a block
define mount model
(
  size [0.02 0.02 0.5]
  gui_nose 0
)

pioneer2dx_with_laser_and_camera 
(
  name "robot_0"
  color "green" 
  pose [ 18 6 0 180 ] 
)

pioneer2dx_with_laser_and_camera 
(
  name "robot_1"
  color "blue" 
  pose [ -16 -7 0 180 ] 
)

pioneer2dx_with_laser_and_camera 
(
  name "robot_2"
  color "red" 
  pose [ 0 8 0 180 ] 
)

pioneer2dx_with_laser_and_camera 
(
  name "robot_3"
  color "yellow" 
  pose [ -1.5 -7 0 180 ] 
)